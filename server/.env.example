# Relay Server Environment Variables Example
PORT=5000
NODE_ENV=development
# Optional: leave empty to use automatic embedded in-memory MongoDB for local dev & evaluation
MONGODB_URI=
JWT_SECRET=super-secure-jwt-secret-relay-hackathon-2026
# Optional: if missing or quota reached, Relay automatically falls back to deterministic rule-based extractor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
# Demo accounts gating (true enables demo accounts on landing page and login)
ALLOW_DEMO_LOGIN=true
DEMO_USER_EMAIL=demo@techforce.dev
DEMO_USER_PASSWORD=Demo@1234
# Optional GitHub token for raised rate limits on GitHub import
GITHUB_TOKEN=
FRONTEND_URL=http://localhost:5173
